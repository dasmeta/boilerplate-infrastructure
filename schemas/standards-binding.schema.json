{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dasmeta/boilerplate-infrastructure/schemas/standards-binding.schema.json",
  "title": "Customer infrastructure standards binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "module_policy",
    "sources",
    "applicable_skills",
    "approvals",
    "exceptions"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "status": { "$ref": "#/$defs/status" },
    "module_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preference", "alternatives_allowed", "alternative_requirements"],
      "properties": {
        "preference": { "const": "dasmeta-preferred" },
        "alternatives_allowed": { "type": "boolean" },
        "alternative_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "applicable_skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    },
    "approvals": {
      "type": "array",
      "items": { "$ref": "#/$defs/approval" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["bound", "read-only", "planned", "not-applicable", "gap"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "locator", "version", "authority", "owner"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "authority": {
          "type": "string",
          "enum": ["authoritative", "supporting"]
        },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "authority_source", "required"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "authority_source": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "status", "owner", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["proposed", "approved", "expired", "rejected"] },
        "owner": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "expires": { "type": ["string", "null"] }
      }
    }
  }
}
