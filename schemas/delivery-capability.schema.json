{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped delivery capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "scope", "owner", "status"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "scope": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["bound", "gap", "disabled", "stale"] },
    "reason": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "locator": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["read", "publish", "update"] },
    "connector": { "type": "string", "minLength": 1 },
    "release": { "type": "string", "pattern": "^(v?[0-9]+([.][0-9]+){1,3}([-+][0-9A-Za-z.-]+)?|[a-fA-F0-9]{40}|(sha256:)?[a-fA-F0-9]{64})$" },
    "mapping": { "type": "object" }
  },
  "if": { "properties": { "status": { "const": "bound" } } },
  "then": { "required": ["provider", "locator", "operation", "connector", "release"] },
  "else": { "required": ["reason"] }
}
