{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dasmeta/boilerplate-infrastructure/schemas/infrastructure-source-index.schema.json",
  "title": "Infrastructure repository and stack source index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "customer_id", "repositories"],
  "properties": {
    "schema_version": { "const": "v1" },
    "customer_id": { "type": "string", "minLength": 1 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "description",
        "locator",
        "authority",
        "scope",
        "dependencies",
        "required",
        "status",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": [
            "infrastructure-control",
            "delivery-orchestrator",
            "data-platform",
            "application",
            "module-source",
            "governance",
            "validation",
            "other"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "remotes": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "authority": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "declared-infrastructure-intent",
              "delivery-configuration",
              "application-contract",
              "data-platform-contract",
              "module-implementation",
              "standards-policy",
              "validation-evidence",
              "supporting-context"
            ]
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["bound", "read-only", "planned", "not-applicable", "gap"]
        },
        "owner": { "type": "string", "minLength": 1 }
      }
    }
  }
}
